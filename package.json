{
  "name": "linknest",
  "version": "1.0.0",
  "private": true,
  "description": "Previewed Discord resource directories without click tracking",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run lint && npm test && node scripts/check-supply.mjs",
    "setup": "node scripts/setup.mjs",
    "register": "npm run build && node dist/src/register.js",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  }
}
